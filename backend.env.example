# backend.env.example template
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__DefaultConnection=Server=tcp:YOUR_SERVER.database.windows.net,1433;Initial Catalog=YOUR_DATABASE;Persist Security Info=False;User ID=YOUR_USERNAME;Password=YOUR_PASSWORD;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=True;Connection Timeout=30;
ConnectionStrings__BlobStorage=DefaultEndpointsProtocol=https;AccountName=YOUR_AZURE_STORAGE_ACCOUNT;AccountKey=YOUR_AZURE_STORAGE_KEY;EndpointSuffix=core.windows.net
AppSettings:Issuer=MyAwesomeApp
AppSettings:Audience=MyAwesomeAudience
AppSettings:Token=ReplaceThisWithASecureRandomKeyThatIsAtLeast32BytesLongForHS512AlgorithmSecurity
